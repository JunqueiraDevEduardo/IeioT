<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomePageL2"
    android:orientation="horizontal"
    tools:ignore="MissingDefaultResource">

    <DatePicker
        android:id="@+id/calendar"
        android:layout_width="487dp"
        android:layout_height="224dp"
        android:layout_centerHorizontal="true"
        android:calendarViewShown="true" />

    <TextView
        android:id="@+id/logo1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:textSize="70dp"
        android:layout_below="@id/calendar"
        android:textColor="#1A63E2"
        android:text="_[ I e i o T ]\_"/>


<Button
    android:id="@+id/sensores"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_below="@id/logo1"
    android:layout_margin="20dp"
    android:text="Sensores"
    android:textSize="30dp"/>

    <Button
        android:id="@+id/atuadores"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/logo1"
        android:layout_alignRight="@id/logo1"
        android:layout_margin="20dp"
        android:text="Atuadores"
        android:textSize="30dp"/>

    <Button
        android:id="@+id/home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estufa"
        android:layout_alignRight="@id/atuadores"
        android:layout_alignParentRight="true"
        android:layout_below="@id/logo1"
        android:textSize="30dp"
        android:layout_margin="20dp"/>
</RelativeLayout>