<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AtuadoresL4"
    tools:ignore="MissingDefaultResource"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/logo2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:textSize="70dp"
        android:textColor="#1A63E2"
        android:text="_[ I e i o T ]\_"/>
    <TextView
        android:id="@+id/inicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/logo2"
        android:textSize="20dp"
        android:text="_________________________________________________________________________________________________">

    </TextView>
    <TextView
        android:id="@+id/Title2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/inicio"
        android:layout_centerHorizontal="true"
        android:text="Dados dos Atuadores"
        android:textSize="40dp" />

    <TextView
        android:id="@+id/LUZ"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/Title2"
        android:text="Luz"
        android:textColor="#47F501"
        android:textSize="30dp"/>

    <TextView
        android:id="@+id/ON"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignRight="@+id/LUZ"
        android:text="ON"
        android:textColor="#47F501"
        android:textSize="30dp"/>

    <TextView
        android:id="@+id/OFF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ON"
        android:text="OFF"
        android:textColor="#47F501"
        android:textSize="30dp"/>


    <TextView
        android:id="@+id/Ventoinha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/Title2"
        android:layout_centerHorizontal="true"
        android:text="Ventoinha"
        android:textColor="#47F501"
        android:textSize="30dp"/>

    <TextView
        android:id="@+id/ON1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignRight="@+id/Ventoinha"
        android:text="ON"
        android:textColor="#47F501"
        android:textSize="30dp"/>

    <TextView
        android:id="@+id/OFF1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ON1"
        android:text="OFF"
        android:textColor="#47F501"
        android:textSize="30dp"/>


</RelativeLayout>