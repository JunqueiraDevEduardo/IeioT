<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".IniciarSessaoL1">

    <TextView
        android:id="@+id/inicio0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:textColor="#1A63E2"
        android:textSize="60dp"
        android:text="_______">

    </TextView>

    <TextView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:textSize="70dp"
        android:layout_below="@id/inicio0"
        android:textColor="#1A63E2"
        android:text="_[ I e i o T ]\_">
    </TextView>
    <TextView
        android:id="@+id/inicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/logo"
        android:textSize="60dp"
        android:text="_______________">

    </TextView>
    <TextView
        android:id="@+id/Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/inicio"
        android:layout_centerHorizontal="true"
        android:layout_margin="40dp"
        android:text="INICIAR SESSÃO"
        android:textSize="40dp" />

    <TextView
        android:id="@+id/linha1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/Title"
        android:textColor="@color/material_dynamic_neutral_variant80"
        android:textSize="60dp"
        android:text="_______________">

    </TextView>
    <TextView
        android:id="@+id/idcliente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30dp"
        android:layout_below="@+id/linha1"
        android:text="ID CLIENTE:" />


    <EditText
        android:id="@+id/insertidcliente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/idcliente">

    </EditText>

    <TextView
        android:id="@+id/linha2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/idcliente"
        android:textColor="@color/material_dynamic_neutral_variant80"
        android:textSize="60dp"
        android:text="_______________">

    </TextView>
        <TextView
            android:id="@+id/palavrapass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/linha2"

            android:textSize="30dp"
            android:text="Palavra Pass:" />

    <EditText
        android:id="@+id/insertpalavrapass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/palavrapass">

    </EditText>


        <Button
            android:id="@+id/entrar"
            android:layout_width="200dp"
            android:layout_weight="10"
            android:layout_margin="30dp"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/insertpalavrapass"
            android:layout_height="wrap_content"
            android:text="ENTRAR"/>
    <TextView
        android:id="@+id/Referencia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/entrar"
        android:text="No âmbito da Unidade Curricular de Laboratório de Mecatrónica, esta aplicação foi concedida
para IeioT, ou seja, Internet of Things em Estufa Inteligente. GitHub: junqueiradeveduardo@gmail.com">

    </TextView>

</RelativeLayout>